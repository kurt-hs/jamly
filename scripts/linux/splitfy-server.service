# splitfy HTTP status server — portable SERVICE launcher (Linux).
#
# Starts the queue-status HTTP server as a background service so it survives
# reboots, mirroring `windows/start-splitfy-server.bat` and the PowerShell
# scheduled-task scripts. Requires systemd; on a box without it, run the
# foreground variant directly:  python -m splitfy.server --port 8765
#
# Usage (from anywhere):
#   sudo systemctl start|stop|status|restart splitfy-server.service

[Unit]
Description=splitfy audio-separation HTTP status server
Documentation=file:///$(pwd)/README.md
After=network.target

# Fill in real install locations on THIS box — all three of these must point at the same dir:
#   WorkingDirectory  == Environment AUTOCV_SCOPE  == --scope arg below.
# `python3 -m splitfy.server` needs the package importable from that dir, so either do an
# editable install (`pip install -e .`) or export PYTHONPATH to the repo root. User=root is only
# needed if that dir isn't writable by your normal user; drop it (and use a real user) otherwise.
[Service]
Type=simple
WorkingDirectory=/opt/splitfy             # absolute path to the checkout (edit)
Environment=AUTOCV_SCOPE=/opt/splitfy     # tool resolution scope = repo root
ExecStart=/usr/bin/python3 -m splitfy.server --port 8765 --scope /opt/splitfy
Restart=always
User=root                                  # edit as appropriate

[Install]
WantedBy=multi-user.target
