# jamly HTTP status server — portable SERVICE launcher (Linux).
#
# Starts the queue-status HTTP server as a background service so it survives
# reboots, mirroring `windows/start-jamly-server.bat` and the PowerShell
# scheduled-task scripts. Requires systemd; on a box without it, run the
# foreground variant directly:  python -m jamly.server --port 8765
#
# Example user service for a checkout at ~/jamly. The launch script generates this file with the
# actual checkout, Python, and port, so manual installation is normally unnecessary.

[Unit]
Description=jamly audio-separation HTTP status server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/jamly
Environment="JAMLY_SCOPE=%h/jamly"
Environment="PYTHONPATH=%h/jamly/src"
ExecStart=/usr/bin/env python3 -m jamly.server --port 8765 --scope %h/jamly
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
