{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "unittest",
            "type": "shell",
            "command": "python -m unittest discover -s tests",
            "options": { "/d": "/s" }
        },
        {
            "label": "pytest",
            "type": "shell",
            "command": "PYTHONPATH=src python -m pytest tests",
            "options": { "/d": "/s" }
        },
        {
            "label": "run-server",
            "type": "shell",
            "command": "PYTHONPATH=src python -m splitfy.server",
            "options": { "/d": "/s" }
        }
    ]
}
