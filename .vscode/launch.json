{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest-debug",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "-s",
                "-o",
                "failfast=true",
                "tests"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "unittest-debug",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "-m",
                "unittest",
                "discover",
                "-s",
                "tests"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "run-server",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "-m",
                "splitfy.server"
            ],
            "console": "integratedTerminal"
        }
    ]
}
