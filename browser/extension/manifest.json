{
  "manifest_version": 3,
  "name": "jamly status",
  "version": "1.0.0",
  "description": "Enqueue audio-separation jobs from an always-on background page; polls the jamly /status server for live progress.",
  "author": "jamly",
  "background": {
    "service_worker": "jamly_extension_bg.js"
  },
  "action": {
    "default_popup": "jamly_popup.html",
    "default_title": "jamly status",
    "default_icon": {}
  },
  "options_ui": {
    "page": "jamly_options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": []
}
